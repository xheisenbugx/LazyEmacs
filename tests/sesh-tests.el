                    ("SPC TAB d" . lazyemacs-sesh-detach) ("SPC TAB D" . lazyemacs-sesh-kill)
                    ("SPC TAB w" . lazyemacs-sesh-worktree-add) ("SPC ," . lazyemacs-sesh-buffer)
                    ("SPC q s" . lazyemacs-sesh-restore) ("SPC q S" . lazyemacs-sesh-save-all)
                    ("SPC q l" . lazyemacs-sesh-restore-last) ("SPC q d" . lazyemacs-sesh-stop-saving)))
