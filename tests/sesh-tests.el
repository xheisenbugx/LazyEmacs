;;; sesh-tests.el --- Sesh-style sessions -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'consult)

(defvar lazyemacs-sesh-test-dir nil
  "Disposable directory of the running test.")
(defvar lazyemacs-sesh-test-executed nil)

(defmacro lazyemacs-sesh-test (&rest body)
  "Run BODY with disposable session state, closing its sessions afterwards."
  (declare (indent 0))
  `(let* ((lazyemacs-sesh-test-dir
           (file-name-as-directory (file-truename (make-temp-file "lazyemacs-sesh-" t))))
          (lazyemacs-sesh-directory (expand-file-name "var/sessions/" lazyemacs-sesh-test-dir))
          (lazyemacs-sesh-state-file (expand-file-name "var/state.eld" lazyemacs-sesh-test-dir))
          (lazyemacs-sesh-trust-file (expand-file-name "var/trusted.eld" lazyemacs-sesh-test-dir))
          (lazyemacs-sesh-sessions nil)
          (lazyemacs-sesh--previous nil)
          (lazyemacs-sesh--inhibit-save nil)
          (lazyemacs-sesh--written (make-hash-table :test #'equal))
          (lazyemacs-sesh-open-root-function #'dired)
          (lazyemacs-dashboard nil)
          (tab-bar-new-tab-choice "*scratch*"))
     (project-tab-sessions-switch "Main")
     (delete-other-windows)
     (unwind-protect (progn ,@body)
       (project-tab-sessions-switch "Main")
       (delete-other-windows)
       (dolist (name (lazyemacs-sesh--live-names))
         (unless (equal name "Main") (tab-bar-close-group-tabs name)))
       (dolist (buffer (buffer-list))
         (when-let* ((file (with-current-buffer buffer
                             (or buffer-file-name (and (derived-mode-p 'dired-mode
                                                                       'my/session-terminal-mode)
                                                       default-directory)))))
           (when (string-prefix-p lazyemacs-sesh-test-dir (expand-file-name file))
             (with-current-buffer buffer (set-buffer-modified-p nil))
             (kill-buffer buffer))))
       (delete-directory lazyemacs-sesh-test-dir t))))

(defun lazyemacs-sesh-test-project (name &rest files)
  "Create directory NAME in the test directory holding FILES; return it."
  (let ((root (file-name-as-directory (expand-file-name name lazyemacs-sesh-test-dir))))
    (make-directory root t)
    (dolist (file files)
      (with-temp-file (expand-file-name file root) (insert "first\nsecond\nthird\n")))
    root))

(defun lazyemacs-sesh-test-git (directory &rest args)
  "Run git ARGS in DIRECTORY, failing the test on error."
  (let ((default-directory directory))
    (with-temp-buffer
      (unless (eq 0 (apply #'call-process "git" nil t nil args))
        (ert-fail (list "git failed" args (buffer-string)))))))

(defun lazyemacs-sesh-test-repo (name)
  "Create a Git repository NAME with one commit; return its root."
  (let ((root (lazyemacs-sesh-test-project name "README.md")))
    (lazyemacs-sesh-test-git root "init" "-q" "-b" "main")
    (lazyemacs-sesh-test-git root "-c" "user.name=T" "-c" "user.email=t@example.invalid"
                             "-c" "commit.gpgsign=false" "add" ".")
    (lazyemacs-sesh-test-git root "-c" "user.name=T" "-c" "user.email=t@example.invalid"
                             "-c" "commit.gpgsign=false" "commit" "-q" "-m" "init")
    root))

(defun lazyemacs-sesh-test-tab-names (name)
  "Return the tab names of session NAME."
  (mapcar (lambda (entry) (alist-get 'name (cdr entry))) (project-tab-sessions--tabs name)))

(ert-deftest lazyemacs-sesh/save-and-lazy-restore-round-trip ()
  (lazyemacs-sesh-test
    (let* ((root (lazyemacs-sesh-test-project "alpha" "a.txt" "b.txt"))
           (a (expand-file-name "a.txt" root))
           (b (expand-file-name "b.txt" root)))
      (lazyemacs-sesh-connect-to root)
      (should (equal (lazyemacs-sesh--current) "alpha"))
      (should (equal (lazyemacs-sesh--live-root "alpha") root))
      (find-file a)
      (goto-char 8)
      (tab-bar-rename-tab "code")
      (let ((tab-bar-new-tab-choice "*scratch*")) (tab-bar-new-tab))
      (tab-bar-rename-tab "review")
      (find-file b)
      (split-window-right)
      (other-window 1)
      (dired root)
      (lazyemacs-sesh-save "alpha")
      (should (file-exists-p (lazyemacs-sesh--file "alpha")))
      (should (file-exists-p (lazyemacs-sesh--file "alpha" ".lock")))
      (should-not (string-match-p "#<" (with-temp-buffer
                                         (insert-file-contents (lazyemacs-sesh--file "alpha"))
                                         (buffer-string))))
      ;; Simulate a restart: no layouts and no buffers for this session.
      (lazyemacs-sesh--close "alpha")
      (kill-buffer (get-file-buffer a))
      (kill-buffer (get-file-buffer b))
      (kill-buffer (dired-noselect root))
      (should-not (lazyemacs-sesh--live-p "alpha"))
      (should-not (file-exists-p (lazyemacs-sesh--file "alpha" ".lock")))
      ;; Saved sessions load lazily: nothing is visited until you connect.
      (should (lazyemacs-sesh--saved-data "alpha"))
      (should-not (get-file-buffer a))
      (lazyemacs-sesh-connect-to "alpha")
      (should (equal (lazyemacs-sesh-test-tab-names "alpha") '("code" "review")))
      (should (equal (alist-get 'name (tab-bar--current-tab-find)) "review"))
      (should (= 2 (length (window-list nil 'nomini))))
      (should (seq-some (lambda (w) (with-current-buffer (window-buffer w) (derived-mode-p 'dired-mode)))
                        (window-list nil 'nomini)))
      (should (get-file-buffer b))
      (project-tab-sessions-select-tab 1)
      (should (eq (window-buffer) (get-file-buffer a)))
      (should (= 8 (point)))
      (dolist (entry (project-tab-sessions--tabs "alpha"))
        (should (equal (alist-get 'project-tab-sessions-root (cdr entry)) root)))
      (should (lazyemacs-sesh-buffer-p (get-file-buffer a) "alpha")))))

(ert-deftest lazyemacs-sesh/restore-skips-missing-files-and-directories ()
  (lazyemacs-sesh-test
    (let* ((root (lazyemacs-sesh-test-project "gone" "a.txt"))
           (a (expand-file-name "a.txt" root)))
      (lazyemacs-sesh-connect-to root)
      (find-file a)
      (split-window-right)
      (lazyemacs-sesh-save "gone")
      (lazyemacs-sesh--close "gone")
      (kill-buffer (get-file-buffer a))
      (kill-buffer (dired-noselect root))
      (delete-directory root t)
      (lazyemacs-sesh-connect-to "gone")
      (should (lazyemacs-sesh--live-p "gone"))
      (should-not (get-file-buffer a))
      ;; Nothing could be restored, so the layout collapses to one window.
      (should (= 1 (length (window-list nil 'nomini))))
      (should (equal (buffer-name (window-buffer)) "*scratch*")))))

(defun lazyemacs-sesh-test-owner ()
  "Start a disposable Emacs process to stand in for another session owner."
  (make-process :name "lazyemacs-sesh-owner" :noquery t
                :command (list (expand-file-name invocation-name invocation-directory)
                               "-Q" "--batch" "--eval" "(sleep-for 60)")))

(ert-deftest lazyemacs-sesh/locks-protect-sessions-of-other-emacs ()
  (lazyemacs-sesh-test
    (let ((root (lazyemacs-sesh-test-project "locked" "a.txt"))
          (owner (lazyemacs-sesh-test-owner)))
      (unwind-protect
          (progn
            (lazyemacs-sesh-connect-to root)
            (find-file (expand-file-name "a.txt" root))
            (lazyemacs-sesh-save "locked")
            (lazyemacs-sesh--close "locked")
            (should (lazyemacs-sesh--pid-alive-p (process-id owner)))
            (lazyemacs-sesh--write-file (lazyemacs-sesh--file "locked" ".lock")
                                        (list :pid (process-id owner) :host (system-name)))
            (should (lazyemacs-sesh--lock-owner "locked"))
            (should-error (lazyemacs-sesh-connect-to "locked") :type 'user-error)
            (should-not (lazyemacs-sesh--live-p "locked"))
            (should-error (lazyemacs-sesh-forget "locked") :type 'user-error)
            ;; Once that Emacs exits, its lock is stale and is ignored.
            (delete-process owner)
            (while (process-live-p owner) (accept-process-output nil 0.05))
            (with-timeout (5 (ert-fail "Owner process did not exit"))
              (while (lazyemacs-sesh--pid-alive-p (process-id owner)) (sleep-for 0.05)))
            (should-not (lazyemacs-sesh--lock-owner "locked"))
            (lazyemacs-sesh-connect-to "locked")
            (should (lazyemacs-sesh--live-p "locked"))
            (should (equal (plist-get (lazyemacs-sesh--read-file
                                       (lazyemacs-sesh--file "locked" ".lock"))
                                      :pid)
                           (emacs-pid))))
        (when (process-live-p owner) (delete-process owner))))))

(ert-deftest lazyemacs-sesh/stale-and-foreign-locks ()
  (lazyemacs-sesh-test
    (make-directory lazyemacs-sesh-directory t)
    (lazyemacs-sesh--write-file (lazyemacs-sesh--file "stale" ".lock")
                                (list :pid 999999999 :host (system-name)))
    (should-not (lazyemacs-sesh--lock-owner "stale"))
    (lazyemacs-sesh--write-file (lazyemacs-sesh--file "garbage" ".lock") "not a lock")
    (should-not (lazyemacs-sesh--lock-owner "garbage"))
    ;; A lock from another machine cannot be checked, so it is respected.
    (lazyemacs-sesh--write-file (lazyemacs-sesh--file "remote" ".lock")
                                (list :pid 1 :host "another-host.invalid"))
    (should (lazyemacs-sesh--lock-owner "remote"))))

(ert-deftest lazyemacs-sesh/detach-keeps-buffers-and-saves ()
  (lazyemacs-sesh-test
    (let* ((root (lazyemacs-sesh-test-project "detach" "a.txt"))
           (file (expand-file-name "a.txt" root)))
      (lazyemacs-sesh-connect-to root)
      (find-file file)
      (insert "unsaved ")
      (lazyemacs-sesh-detach "detach")
      (should-not (lazyemacs-sesh--live-p "detach"))
      (should (buffer-live-p (get-file-buffer file)))
      (should (buffer-modified-p (get-file-buffer file)))
      (should (lazyemacs-sesh--saved-data "detach"))
      (should-not (file-exists-p (lazyemacs-sesh--file "detach" ".lock")))
      (should (equal (lazyemacs-sesh--current) "Main"))
      ;; Reconnecting reuses the live buffer instead of reverting it.
      (lazyemacs-sesh-connect-to "detach")
      (should (eq (window-buffer) (get-file-buffer file)))
      (should (buffer-modified-p (window-buffer))))))

(ert-deftest lazyemacs-sesh/last-session-is-never-closed ()
  (lazyemacs-sesh-test
    (let ((root (lazyemacs-sesh-test-project "only" "a.txt")))
      (lazyemacs-sesh-connect-to root)
      (tab-bar-close-group-tabs "Main")
      (should (equal (lazyemacs-sesh--live-names) '("only")))
      (lazyemacs-sesh-detach "only")
      (should (equal (lazyemacs-sesh--live-names) '("Main")))
      ;; Detaching the default session itself opens a fresh one.
      (lazyemacs-sesh-detach "Main")
      (should (equal (lazyemacs-sesh--live-names) '("Main"))))))

(ert-deftest lazyemacs-sesh/kill-removes-only-session-buffers ()
  (lazyemacs-sesh-test
    (let* ((root (lazyemacs-sesh-test-project "kill" "a.txt" "shared.txt"))
           (other (lazyemacs-sesh-test-project "elsewhere" "outside.txt"))
           (a (find-file-noselect (expand-file-name "a.txt" root)))
           (shared (find-file-noselect (expand-file-name "shared.txt" root)))
           (outside (find-file-noselect (expand-file-name "outside.txt" other)))
           (process-buffer (generate-new-buffer "*kill-test-process*")))
      (with-current-buffer process-buffer (setq default-directory root))
      (start-process "kill-test" process-buffer
                     (expand-file-name invocation-name invocation-directory)
                     "-Q" "--batch" "--eval" "(sleep-for 60)")
      (lazyemacs-sesh-connect-to other)
      (switch-to-buffer shared)
      (lazyemacs-sesh-connect-to root)
      (dolist (buffer (list a shared outside process-buffer))
        (switch-to-buffer buffer))
      (lazyemacs-sesh--track-windows (selected-frame))
      (dolist (buffer (list a outside process-buffer))
        (lazyemacs-sesh--mark-buffer buffer "kill"))
      (lazyemacs-sesh--mark-buffer shared "elsewhere")
      (lazyemacs-sesh--mark-buffer shared "kill")
      (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
        (lazyemacs-sesh-kill "kill"))
      (should-not (lazyemacs-sesh--live-p "kill"))
      (should-not (buffer-live-p a))
      (should-not (buffer-live-p process-buffer))
      (should (buffer-live-p shared))
      (should (buffer-live-p outside))
      ;; Killing never deletes the saved layout; forgetting does.
      (should-not (file-exists-p (lazyemacs-sesh--file "kill" ".lock"))))))

(ert-deftest lazyemacs-sesh/kill-asks-first ()
  (lazyemacs-sesh-test
    (let ((root (lazyemacs-sesh-test-project "ask" "a.txt")))
      (lazyemacs-sesh-connect-to root)
      (find-file (expand-file-name "a.txt" root))
      (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) nil)))
        (lazyemacs-sesh-kill "ask"))
      (should (lazyemacs-sesh--live-p "ask"))
      (should (get-file-buffer (expand-file-name "a.txt" root))))))

(ert-deftest lazyemacs-sesh/last-session-toggle ()
  (lazyemacs-sesh-test
    (lazyemacs-sesh-connect-to "One")
    (lazyemacs-sesh-connect-to "Two")
    (lazyemacs-sesh-last)
    (should (equal (lazyemacs-sesh--current) "One"))
    (lazyemacs-sesh-last)
    (should (equal (lazyemacs-sesh--current) "Two"))
    ;; Switching through the tab bar also counts.
    (project-tab-sessions-switch "One")
    (should (equal lazyemacs-sesh--previous "Two"))
    (let ((lazyemacs-sesh--previous nil))
      (should-error (lazyemacs-sesh-last) :type 'user-error))))

(ert-deftest lazyemacs-sesh/last-session-restores-a-detached-one ()
  (lazyemacs-sesh-test
    (let ((root (lazyemacs-sesh-test-project "back" "a.txt")))
      (lazyemacs-sesh-connect-to root)
      (find-file (expand-file-name "a.txt" root))
      (lazyemacs-sesh-detach "back")
      (lazyemacs-sesh-last)
      (should (equal (lazyemacs-sesh--current) "back")))))

(ert-deftest lazyemacs-sesh/configured-session-builds-layouts ()
  (lazyemacs-sesh-test
    (let* ((root (lazyemacs-sesh-test-project "configured" "a.txt"))
           (terminal (generate-new-buffer "*configured-terminal*"))
           sent started)
      (make-directory (expand-file-name "docs" root))
      (lazyemacs-define-session "Configured"
                                :root root
                                :layouts '(("code" :file "a.txt")
                                           ("docs" :dired "docs")
                                           ("server" :file "a.txt" :terminal "make serve")
                                           ("missing" :file "nope.txt"))
                                :startup (lambda () (setq started default-directory)))
      (should (member "Configured" (mapcar #'car lazyemacs-sesh-sessions)))
      (unwind-protect
          (cl-letf (((symbol-function 'my/terminal-create)
                     (lambda (_name action) (pop-to-buffer terminal action) terminal))
                    ((symbol-function 'my/terminal-send)
                     (lambda (buffer string) (push (cons buffer string) sent))))
            (lazyemacs-sesh-connect-to "Configured")
            (should (equal (lazyemacs-sesh-test-tab-names "Configured")
                           '("code" "docs" "server" "missing")))
            (should (equal (lazyemacs-sesh--current) "Configured"))
            (should (eq (window-buffer) (get-file-buffer (expand-file-name "a.txt" root))))
            (project-tab-sessions-select-tab 2)
            (with-current-buffer (window-buffer)
              (should (derived-mode-p 'dired-mode))
              (should (equal default-directory (expand-file-name "docs/" root))))
            (project-tab-sessions-select-tab 3)
            (should (= 2 (length (window-list nil 'nomini))))
            (should (equal sent (list (cons terminal "make serve"))))
            (project-tab-sessions-select-tab 4)
            (with-current-buffer (window-buffer) (should (derived-mode-p 'dired-mode)))
            (should (equal started root))
            ;; Once live, connecting again switches instead of rebuilding.
            (lazyemacs-sesh-connect-to "Main")
            (lazyemacs-sesh-connect-to "Configured")
            (should (= 1 (length sent))))
        (kill-buffer terminal)))))

(ert-deftest lazyemacs-sesh/project-file-is-data-and-needs-trust ()
  (lazyemacs-sesh-test
    (let* ((root (lazyemacs-sesh-test-project "untrusted" "a.txt"))
           (file (expand-file-name ".lazyemacs-session.el" root))
           (lazyemacs-sesh-test-executed nil)
           asked)
      (with-temp-file file
        (insert "(:name \"Local\" :startup lazyemacs-sesh-test-mark\n"
                " :layouts ((\"code\" :file \"a.txt\") (\"shell\" :terminal \"rm -rf build\")))\n"
                "(setq lazyemacs-sesh-test-executed 'loaded)\n"))
      (defalias 'lazyemacs-sesh-test-mark (lambda () (setq lazyemacs-sesh-test-executed 'startup)))
      (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) (setq asked t) nil))
                ((symbol-function 'my/terminal-create)
                 (lambda (&rest _) (ert-fail "Started a terminal without consent")))
                ((symbol-function 'load) (lambda (&rest _) (ert-fail "Loaded a project file"))))
        (lazyemacs-sesh-connect-to root))
      (should asked)
      (should-not lazyemacs-sesh-test-executed)
      (should (equal (lazyemacs-sesh--current) "Local"))
      (should (equal (lazyemacs-sesh-test-tab-names "Local") '("code" "shell")))
      (project-tab-sessions-select-tab 2)
      (with-current-buffer (window-buffer)
        (should (eq major-mode 'my/session-terminal-mode))
        (should-not (get-buffer-process (current-buffer))))
      (should-not (lazyemacs-sesh--trusted-p file))
      ;; Trusting runs commands and remembers this exact file content.
      (lazyemacs-sesh--close "Local")
      (let (sent)
        (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) t))
                  ((symbol-function 'my/terminal-create)
                   (lambda (&rest _) (get-buffer-create "*trusted-terminal*")))
                  ((symbol-function 'my/terminal-send)
                   (lambda (_buffer string) (push string sent))))
          (lazyemacs-sesh-rebuild "Local"))
        (should (equal sent '("rm -rf build")))
        (should (eq lazyemacs-sesh-test-executed 'startup))
        (should (lazyemacs-sesh--trusted-p file))
        (kill-buffer "*trusted-terminal*"))
      ;; Editing the file withdraws the trust.
      (with-temp-file file (insert "(:layouts ((\"x\" :terminal \"curl evil\")))\n"))
      (should-not (lazyemacs-sesh--trusted-p file)))))

(ert-deftest lazyemacs-sesh/picker-sources-dedupe-and-annotate ()
  (lazyemacs-sesh-test
    (let* ((live-root (lazyemacs-sesh-test-repo "live"))
           (saved-root (lazyemacs-sesh-test-project "saved" "a.txt"))
           (project (lazyemacs-sesh-test-project "project"))
           (other (lazyemacs-sesh-test-project "other"))
           (zoxide (lazyemacs-sesh-test-project "zoxide")))
      (lazyemacs-sesh-connect-to saved-root)
      (find-file (expand-file-name "a.txt" saved-root))
      (lazyemacs-sesh-detach "saved")
      (lazyemacs-sesh-connect-to live-root)
      (lazyemacs-define-session "Declared" :root project)
      (cl-letf (((symbol-function 'project-known-project-roots)
                 (lambda () (list live-root saved-root project other)))
                ((symbol-function 'executable-find)
                 (lambda (name &rest _) (if (equal name "zoxide") "/bin/zoxide" "/usr/bin/git")))
                ((symbol-function 'lazyemacs-sesh--zoxide-directories)
                 (lambda () (list live-root saved-root other zoxide
                                  (expand-file-name "does-not-exist" lazyemacs-sesh-test-dir))))
                ((symbol-function 'lazyemacs-sesh--worktrees) #'ignore))
        (let* ((sources (lazyemacs-sesh--sources))
               (items (lambda (narrow)
                        (mapcar #'cdr (plist-get (seq-find (lambda (source)
                                                             (eq (plist-get source :narrow) narrow))
                                                           sources)
                                                 :items)))))
          (should (equal (car (funcall items ?s)) "live"))
          (should (member "Main" (funcall items ?s)))
          (should (equal (funcall items ?d) '("saved")))
          ;; The configured session claims its root, so it is not a project.
          (should (equal (funcall items ?c) '("Declared")))
          (should (equal (funcall items ?p) (list other)))
          (should (equal (funcall items ?z) (list zoxide)))
          (should (string-prefix-p "● " (car (car (plist-get (car sources) :items)))))
          (let ((annotation (funcall (plist-get (car sources) :annotate) "live")))
            (should (string-match-p "main" annotation))
            (should (string-match-p "1 layout" annotation))
            (should (string-match-p (regexp-quote (abbreviate-file-name live-root)) annotation)))
          (let ((annotation (funcall (plist-get (nth 1 sources) :annotate) "saved")))
            (should (string-match-p "ago\\|now" annotation))))))))

(ert-deftest lazyemacs-sesh/zoxide-source-needs-zoxide ()
  (lazyemacs-sesh-test
    (cl-letf (((symbol-function 'executable-find)
               (lambda (name &rest _) (unless (equal name "zoxide") "/usr/bin/git")))
              ((symbol-function 'lazyemacs-sesh--zoxide-directories)
               (lambda () (ert-fail "Ran zoxide although it is missing")))
              ((symbol-function 'lazyemacs-sesh--worktrees) #'ignore))
      (should-not (seq-find (lambda (source) (eq (plist-get source :narrow) ?z))
                            (lazyemacs-sesh--sources))))
    (cl-letf (((symbol-function 'executable-find) #'ignore))
      (should-not (lazyemacs-sesh--zoxide-directories)))))

(ert-deftest lazyemacs-sesh/picker-connects-and-creates ()
  (lazyemacs-sesh-test
    (let ((root (lazyemacs-sesh-test-project "picked")))
      (cl-letf (((symbol-function 'consult--multi)
                 (lambda (&rest _) (list (abbreviate-file-name root) :match t))))
        (lazyemacs-sesh-connect))
      (should (equal (lazyemacs-sesh--current) "picked"))
      (cl-letf (((symbol-function 'consult--multi)
                 (lambda (&rest _) (list "brand new" :match nil))))
        (lazyemacs-sesh-connect))
      (should (equal (lazyemacs-sesh--current) "brand new"))
      (should-not (lazyemacs-sesh--live-root "brand new")))))

(ert-deftest lazyemacs-sesh/worktree-action-creates-a-session ()
  (skip-unless (executable-find "git"))
  (lazyemacs-sesh-test
    (let* ((root (lazyemacs-sesh-test-repo "repo"))
           (worktree (file-name-as-directory (expand-file-name "repo-feature-x" lazyemacs-sesh-test-dir))))
      (lazyemacs-sesh-connect-to root)
      (should (equal (lazyemacs-sesh--worktrees root) (list root)))
      (lazyemacs-sesh-worktree-add "repo" "feature/x")
      (should (file-directory-p worktree))
      (should (equal (lazyemacs-sesh--live-root (lazyemacs-sesh--current)) worktree))
      ;; The branch is read from the worktree's .git file without running Git.
      (should (equal (lazyemacs-sesh--branch worktree) "feature/x"))
      (should (equal (lazyemacs-sesh--worktrees root) (list root worktree)))
      ;; A worktree of the current repository is offered once.
      (cl-letf (((symbol-function 'project-known-project-roots) #'ignore))
        (lazyemacs-sesh-detach (lazyemacs-sesh--current))
        (lazyemacs-sesh-connect-to "repo")
        (let ((sources (lazyemacs-sesh--sources)))
          (should-not (plist-get (seq-find (lambda (s) (eq (plist-get s :narrow) ?w)) sources)
                                 :items)))))))

(ert-deftest lazyemacs-sesh/clone-connects-when-done ()
  (skip-unless (executable-find "git"))
  (lazyemacs-sesh-test
    (let* ((origin (lazyemacs-sesh-test-repo "origin"))
           (lazyemacs-sesh-clone-directory (expand-file-name "clones/" lazyemacs-sesh-test-dir))
           (process (lazyemacs-sesh-clone (directory-file-name origin))))
      (with-timeout (30 (ert-fail "Clone did not finish"))
        (while (process-live-p process) (accept-process-output process 0.1)))
      (accept-process-output nil 0.1)
      (should (equal (lazyemacs-sesh--live-root (lazyemacs-sesh--current))
                     (file-name-as-directory (expand-file-name "origin" lazyemacs-sesh-clone-directory))))
      (should (equal (lazyemacs-sesh--clone-target "git@github.com:me/tool.git")
                     (expand-file-name "tool" lazyemacs-sesh-clone-directory)))
      (kill-buffer "*lazyemacs-clone*"))))

(ert-deftest lazyemacs-sesh/rename-and-forget-saved-files ()
  (lazyemacs-sesh-test
    (let ((root (lazyemacs-sesh-test-project "renamed" "a.txt")))
      (lazyemacs-sesh-connect-to root)
      (find-file (expand-file-name "a.txt" root))
      ;; Batch Emacs does not redisplay, so record the shown buffers by hand.
      (lazyemacs-sesh--track-windows (selected-frame))
      (lazyemacs-sesh-save "renamed")
      (lazyemacs-sesh-rename "renamed" "Better/name")
      (should (lazyemacs-sesh--live-p "Better/name"))
      (should (lazyemacs-sesh-buffer-p (current-buffer) "Better/name"))
      (should-not (file-exists-p (lazyemacs-sesh--file "renamed")))
      (should (lazyemacs-sesh--saved-data "Better/name"))
      (should-error (lazyemacs-sesh-forget "Better/name") :type 'user-error)
      (lazyemacs-sesh-detach "Better/name")
      (lazyemacs-sesh-rename "Better/name" "Closed")
      (should (lazyemacs-sesh--saved-data "Closed"))
      (lazyemacs-sesh-forget "Closed")
      (should-not (lazyemacs-sesh--saved-data "Closed")))))

(ert-deftest lazyemacs-sesh/startup-restores-open-sessions ()
  (lazyemacs-sesh-test
    (let ((one (lazyemacs-sesh-test-project "one" "a.txt"))
          (two (lazyemacs-sesh-test-project "two" "b.txt")))
      (lazyemacs-sesh-connect-to one)
      (find-file (expand-file-name "a.txt" one))
      (lazyemacs-sesh-connect-to two)
      (find-file (expand-file-name "b.txt" two))
      (lazyemacs-sesh-connect-to "one")
      (should (= 2 (lazyemacs-sesh-save-all t)))
      (should (equal (plist-get (lazyemacs-sesh--read-file lazyemacs-sesh-state-file) :current) "one"))
      (lazyemacs-sesh--close "one")
      (lazyemacs-sesh--close "two")
      (project-tab-sessions-switch "Main")
      (tab-bar-close-other-tabs)
      (lazyemacs-sesh-restore t)
      (should (equal (lazyemacs-sesh--live-names) '("one" "two")))
      (should (eq (window-buffer) (get-file-buffer (expand-file-name "a.txt" one))))
      ;; SPC q d: nothing is written for the rest of this Emacs.
      (lazyemacs-sesh-stop-saving)
      (delete-file (lazyemacs-sesh--file "two"))
      (should (zerop (lazyemacs-sesh-save-all t)))
      (should-not (file-exists-p (lazyemacs-sesh--file "two"))))))

(ert-deftest lazyemacs-sesh/session-buffer-source-and-cycling ()
  (lazyemacs-sesh-test
    (let ((mine (get-buffer-create "*sesh-mine*"))
          (theirs (get-buffer-create "*sesh-theirs*")))
      (unwind-protect
          (progn
            (lazyemacs-sesh-connect-to "Theirs")
            (switch-to-buffer theirs)
            (lazyemacs-sesh--track-windows (selected-frame))
            (lazyemacs-sesh-connect-to "Mine")
            (switch-to-buffer mine)
            (lazyemacs-sesh--track-windows (selected-frame))
            (let ((session (mapcar #'cdr (funcall (plist-get lazyemacs-sesh-buffer-source :items))))
                  (all (mapcar #'cdr (funcall (plist-get lazyemacs-sesh-all-buffers-source :items)))))
              (should (memq mine session))
              (should-not (memq theirs session))
              (should (memq theirs all)))
            (should (plist-get lazyemacs-sesh-all-buffers-source :hidden))
            (should (eq (plist-get lazyemacs-sesh-all-buffers-source :narrow) ?a))
            (should (lazyemacs-sesh--skip-buffer-p nil theirs nil))
            (should-not (lazyemacs-sesh--skip-buffer-p nil mine nil))
            ;; H skips the other session's buffer in this window's history.
            (switch-to-buffer theirs)
            (switch-to-buffer mine)
            (let ((scratch (get-scratch-buffer-create)))
              (lazyemacs-sesh--mark-buffer scratch "Mine")
              (switch-to-buffer scratch)
              (switch-to-buffer theirs)
              (switch-to-buffer mine))
            (my/session-previous-buffer)
            (should-not (eq (window-buffer) theirs)))
        (kill-buffer mine)
        (kill-buffer theirs)))))

(ert-deftest lazyemacs-sesh/tab-bar-and-mode-line ()
