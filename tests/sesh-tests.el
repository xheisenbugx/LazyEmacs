(ert-deftest lazyemacs-sesh/cli-script-escapes-its-argument ()
  (skip-unless (and (not (eq system-type 'windows-nt)) (executable-find "sh")))
  (lazyemacs-sesh-test
    (let* ((bin (expand-file-name "bin/" lazyemacs-sesh-test-dir))
           (script (expand-file-name "bin/lazyemacs-connect" lazyemacs-root-directory))
           (process-environment (cons (concat "PATH=" bin path-separator (getenv "PATH"))
                                      process-environment))
           (run (lambda (&rest args)
                  (with-temp-buffer
                    (should (eq 0 (apply #'call-process "sh" nil t nil script args)))
                    (split-string (buffer-string) "\n" t)))))
      (make-directory bin)
      (with-temp-file (expand-file-name "emacsclient" bin)
        (insert "#!/bin/sh\nfor a in \"$@\"; do printf '%s\\n' \"$a\"; done\n"))
      (set-file-modes (expand-file-name "emacsclient" bin) #o755)
      (let* ((target "we\"ird \\ name $(rm -rf ~) `x`")
             (args (funcall run "-s" "lazyemacs-test" target)))
        (should (equal (seq-take args 4) '("-s" "lazyemacs-test" "-n" "-e")))
        (should (equal (read (nth 4 args)) `(lazyemacs-sesh-cli-connect ,target))))
      (let* ((directory (lazyemacs-sesh-test-project "cli dir"))
             (args (let ((default-directory directory)) (funcall run))))
        (should (equal (read (car (last args)))
                       `(lazyemacs-sesh-cli-connect ,(directory-file-name directory)))))
      ;; With -c, the fake client reports no frame, so one is created.
      (should (member "-c" (funcall run "-c" "name"))))))

